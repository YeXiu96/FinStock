# ========================================
# FinStocks — Environment Variables
# ========================================
# Salin file ini ke .env dan sesuaikan nilainya

# === BACKEND ===
# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/finstocks_db"

# JWT
JWT_SECRET=finstocks_jwt_secret_key_ganti_ini_di_production
JWT_EXPIRES_IN=8h

# === FRONTEND ===
VITE_API_BASE_URL=http://localhost:5000/api
