# ============================================
# FinStocks Backend — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilainya

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/finstocks_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Nodemailer)
# Kosongkan untuk mode simulasi dev (OTP dicetak di terminal)
# Atau isi dengan kredensial Gmail / Mailtrap:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="FinStock UMKM" <no-reply@finstocks.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FinStock UMKM" <no-reply@finstocks.com>

